generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String          @id @default(cuid())
  clerkId   String          @unique
  email     String          @unique
  firstName String?
  lastName  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  companies CompanyMember[]
  bidsPlaced Bid[]           @relation("BidPlacedByUser")
}

model Company {
  id          String          @id @default(cuid())
  name        String
  abn         String?         @unique
  verified    Boolean         @default(false)
  companyType String?
  locations   String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     CompanyMember[]
  listings    Listing[]
  bids        Bid[]           @relation("BidderCompany")
}

model CompanyMember {
  id        String      @id @default(cuid())
  role      CompanyRole @default(STAFF)
  userId    String
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Listing {
  id                  String   @id @default(cuid())
  companyId           String
  listingType         String
  title               String
  location            String?
  origin              String?
  destination         String?
  capacityAmount      Int
  capacityUnit        String
  temperatureClass    String
  availableFrom       DateTime
  availableTo         DateTime
  startingBid         Decimal  @db.Decimal(12, 2)
  minimumBidIncrement Decimal  @db.Decimal(12, 2)
  notes               String?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bids                Bid[]

  @@index([companyId])
  @@index([status])
  @@index([listingType])
}

model Bid {
  id              String   @id @default(cuid())
  listingId       String
  bidderCompanyId String
  placedByUserId  String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompany   Company  @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Restrict)
  placedByUser    User     @relation("BidPlacedByUser", fields: [placedByUserId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([bidderCompanyId])
  @@index([placedByUserId])
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  DISPATCHER
  DRIVER
  WAREHOUSE
  STAFF
}
