generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id @default(cuid())
  clerkId                String            @unique
  email                  String            @unique
  firstName              String?
  lastName               String?
  accountType            String?
  platformRole           String            @default("USER")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  companies              CompanyMember[]
  bidsPlaced             Bid[]             @relation("BidPlacedByUser")
  jobEvents              JobEvent[]        @relation("JobEventActorUser")
  tendersCreated         Tender[]          @relation("TenderCreatedByUser")
  tenderResponses        TenderResponse[]  @relation("TenderResponseSubmittedByUser")
  notifications          Notification[]    @relation("NotificationRecipientUser")
  reviewsSubmitted       Review[]          @relation("ReviewSubmittedByUser")
  guestReviewsSubmitted  GuestAuctionReview[] @relation("GuestAuctionReviewSubmittedByUser")
  verificationsReviewed  Company[]         @relation("CompanyVerificationReviewer")
  guestAuctionsCreated   GuestAuction[]    @relation("GuestAuctionCreatedByUser")
  guestAuctionBidsPlaced GuestAuctionBid[] @relation("GuestAuctionBidPlacedByUser")
  opportunityAlertPreferences OpportunityAlertPreference[]
  commercialTransactionsAsBuyer CommercialTransaction[] @relation("CommercialTransactionBuyerUser")
  promotionsPurchased    Promotion[] @relation("PromotionPurchaserUser")
}

model Company {
  id                           String            @id @default(cuid())
  name                         String
  abn                          String?           @unique
  verified                     Boolean           @default(false)
  verificationStatus           String            @default("UNVERIFIED")
  verificationSubmittedAt      DateTime?
  verificationReviewedAt       DateTime?
  verificationReviewedByUserId String?
  verificationNotes            String?
  companyType                  String?
  locations                    String?
  notes                        String?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  verificationReviewedBy       User?             @relation("CompanyVerificationReviewer", fields: [verificationReviewedByUserId], references: [id], onDelete: SetNull)
  members                      CompanyMember[]
  listings                     Listing[]
  bids                         Bid[]             @relation("BidderCompany")
  buyerJobs                    Job[]             @relation("JobBuyerCompany")
  providerJobs                 Job[]             @relation("JobProviderCompany")
  jobEvents                    JobEvent[]        @relation("JobEventActorCompany")
  tenders                      Tender[]          @relation("TenderOwnerCompany")
  tenderResponses              TenderResponse[] @relation("TenderRespondingCompany")
  notifications                Notification[]    @relation("NotificationCompany")
  reviewsGiven                 Review[]          @relation("ReviewAuthorCompany")
  reviewsReceived              Review[]          @relation("ReviewSubjectCompany")
  guestReviewsReceived         GuestAuctionReview[] @relation("GuestAuctionReviewSubjectCompany")
  guestAuctionBids             GuestAuctionBid[] @relation("GuestAuctionBidderCompany")
  opportunityAlertPreferences  OpportunityAlertPreference[]
  commercialTransactionsAsBuyer CommercialTransaction[] @relation("CommercialTransactionBuyerCompany")
  commercialTransactionsAsProvider CommercialTransaction[] @relation("CommercialTransactionProviderCompany")
  promotionsPurchased          Promotion[] @relation("PromotionPurchaserCompany")

  @@index([verificationReviewedByUserId])
}

model CompanyMember {
  id        String      @id @default(cuid())
  role      CompanyRole @default(STAFF)
  userId    String
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Listing {
  id                  String   @id @default(cuid())
  companyId           String
  listingType         String
  title               String
  location            String?
  origin              String?
  destination         String?
  capacityAmount      Int
  capacityUnit        String
  temperatureClass    String
  availableFrom       DateTime
  availableTo         DateTime
  startingBid         Decimal  @db.Decimal(12, 2)
  minimumBidIncrement Decimal  @db.Decimal(12, 2)
  biddingClosesAt     DateTime?
  awardedBidId        String?  @unique
  awardedAt           DateTime?
  notes               String?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bids                Bid[]    @relation("ListingBids")
  awardedBid          Bid?     @relation("AwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  job                 Job?
  promotions          Promotion[]

  @@index([companyId])
  @@index([status])
  @@index([listingType])
  @@index([biddingClosesAt])
}

model Bid {
  id              String    @id @default(cuid())
  listingId       String
  bidderCompanyId String
  placedByUserId  String
  amount          Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  listing         Listing   @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)
  bidderCompany   Company   @relation("BidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Restrict)
  placedByUser    User      @relation("BidPlacedByUser", fields: [placedByUserId], references: [id], onDelete: Restrict)
  awardedListing  Listing?  @relation("AwardedBid")
  job             Job?

  @@index([listingId, createdAt])
  @@index([bidderCompanyId])
  @@index([placedByUserId])
}

model Job {
  id                      String          @id @default(cuid())
  listingId               String?         @unique
  awardedBidId            String?         @unique
  tenderId                String?         @unique
  awardedTenderResponseId String?         @unique
  buyerCompanyId          String
  providerCompanyId       String
  amount                  Decimal         @db.Decimal(12, 2)
  status                  String          @default("AWARDED")
  acceptedAt              DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  listing                 Listing?        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  awardedBid              Bid?            @relation(fields: [awardedBidId], references: [id], onDelete: Restrict)
  tender                  Tender?         @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  awardedTenderResponse   TenderResponse? @relation(fields: [awardedTenderResponseId], references: [id], onDelete: Restrict)
  buyerCompany            Company         @relation("JobBuyerCompany", fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  providerCompany         Company         @relation("JobProviderCompany", fields: [providerCompanyId], references: [id], onDelete: Restrict)
  events                  JobEvent[]
  reviews                 Review[]
  commercialTransaction   CommercialTransaction?

  @@index([buyerCompanyId])
  @@index([providerCompanyId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id                String   @id @default(cuid())
  jobId             String
  reviewerCompanyId String
  reviewedCompanyId String
  reviewerUserId    String
  rating            Int
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewerCompany   Company  @relation("ReviewAuthorCompany", fields: [reviewerCompanyId], references: [id], onDelete: Restrict)
  reviewedCompany   Company  @relation("ReviewSubjectCompany", fields: [reviewedCompanyId], references: [id], onDelete: Restrict)
  reviewerUser      User     @relation("ReviewSubmittedByUser", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([jobId, reviewerCompanyId])
  @@index([reviewedCompanyId, createdAt])
  @@index([reviewerUserId])
}

model GuestAuctionReview {
  id                String       @id @default(cuid())
  guestAuctionId    String       @unique
  reviewedCompanyId String
  reviewerUserId    String
  rating            Int
  comment           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  guestAuction      GuestAuction @relation(fields: [guestAuctionId], references: [id], onDelete: Cascade)
  reviewedCompany   Company      @relation("GuestAuctionReviewSubjectCompany", fields: [reviewedCompanyId], references: [id], onDelete: Restrict)
  reviewerUser      User         @relation("GuestAuctionReviewSubmittedByUser", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([reviewedCompanyId, createdAt])
  @@index([reviewerUserId])
}

model JobEvent {
  id             String   @id @default(cuid())
  jobId          String
  eventType      String
  actorUserId    String?
  actorCompanyId String?
  note           String?
  metadata       Json?
  createdAt      DateTime @default(now())
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actorUser      User?    @relation("JobEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCompany   Company? @relation("JobEventActorCompany", fields: [actorCompanyId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([actorUserId])
  @@index([actorCompanyId])
}

model Tender {
  id                     String           @id @default(cuid())
  companyId              String
  createdByUserId        String
  title                  String
  productDescription     String
  volume                 String
  origin                 String
  destination            String
  storageRequired        Boolean          @default(false)
  temperatureRequirement String?
  deliveryDate           DateTime
  responseClosesAt       DateTime
  notes                  String?
  status                 String           @default("OPEN")
  awardedResponseId      String?          @unique
  awardedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  company                Company          @relation("TenderOwnerCompany", fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser          User             @relation("TenderCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responses              TenderResponse[] @relation("TenderResponses")
  awardedResponse        TenderResponse?  @relation("AwardedTenderResponse", fields: [awardedResponseId], references: [id], onDelete: SetNull)
  job                    Job?
  promotions             Promotion[]

  @@index([companyId])
  @@index([status])
  @@index([responseClosesAt])
  @@index([createdAt])
}

model TenderResponse {
  id                 String   @id @default(cuid())
  tenderId           String
  companyId          String
  submittedByUserId  String
  amount             Decimal  @db.Decimal(12, 2)
  serviceDescription String?
  leadTime           String?
  notes              String?
  status             String   @default("SUBMITTED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tender              Tender   @relation("TenderResponses", fields: [tenderId], references: [id], onDelete: Cascade)
  company             Company  @relation("TenderRespondingCompany", fields: [companyId], references: [id], onDelete: Restrict)
  submittedByUser     User     @relation("TenderResponseSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  awardedTender       Tender?  @relation("AwardedTenderResponse")
  job                 Job?

  @@unique([tenderId, companyId])
  @@index([tenderId, createdAt])
  @@index([companyId])
  @@index([status])
}

model GuestAuction {
  id              String            @id @default(cuid())
  createdByUserId String
  title           String
  itemDescription String
  pickupLocation  String
  deliveryLocation String
  pickupDate      DateTime?
  deliveryBy      DateTime?
  auctionClosesAt DateTime
  notes           String?
  status          String            @default("OPEN")
  awardedBidId    String?           @unique
  awardedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdByUser   User              @relation("GuestAuctionCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  bids            GuestAuctionBid[] @relation("GuestAuctionBids")
  awardedBid      GuestAuctionBid?  @relation("GuestAuctionAwardedBid", fields: [awardedBidId], references: [id], onDelete: SetNull)
  review          GuestAuctionReview?
  commercialTransaction CommercialTransaction?
  promotions      Promotion[]

  @@index([createdByUserId])
  @@index([status])
  @@index([auctionClosesAt])
  @@index([createdAt])
}

model GuestAuctionBid {
  id                 String       @id @default(cuid())
  guestAuctionId     String
  bidderCompanyId    String
  placedByUserId     String
  amount             Decimal      @db.Decimal(12, 2)
  serviceDescription String?
  leadTime           String?
  notes              String?
  status             String       @default("SUBMITTED")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  auction            GuestAuction @relation("GuestAuctionBids", fields: [guestAuctionId], references: [id], onDelete: Cascade)
  bidderCompany      Company      @relation("GuestAuctionBidderCompany", fields: [bidderCompanyId], references: [id], onDelete: Restrict)
  placedByUser       User         @relation("GuestAuctionBidPlacedByUser", fields: [placedByUserId], references: [id], onDelete: Restrict)
  awardedAuction     GuestAuction? @relation("GuestAuctionAwardedBid")

  @@unique([guestAuctionId, bidderCompanyId])
  @@index([guestAuctionId, createdAt])
  @@index([bidderCompanyId])
  @@index([placedByUserId])
}

model OpportunityAlertPreference {
  id               String   @id @default(cuid())
  userId           String
  companyId        String?
  name             String   @default("My opportunities")
  opportunityTypes String[] @default([])
  areaKeywords     String[] @default([])
  inAppEnabled     Boolean  @default(true)
  emailEnabled     Boolean  @default(true)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([companyId, active])
}

model Notification {
  id              String   @id @default(cuid())
  companyId       String?
  recipientUserId String?
  type            String
  title           String
  message         String
  href            String?
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime @default(now())
  company         Company? @relation("NotificationCompany", fields: [companyId], references: [id], onDelete: Cascade)
  recipientUser   User?    @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([type])
}

model CommercialTransaction {
  id                   String                     @id @default(cuid())
  jobId                String?                    @unique
  guestAuctionId       String?                    @unique
  buyerCompanyId       String?
  buyerUserId          String?
  providerCompanyId    String
  grossAmountMinor     BigInt
  currency             String                     @default("AUD")
  paymentMode          CommercialPaymentMode      @default(UNSET)
  paymentStatus        CommercialPaymentStatus    @default(UNSET)
  settlementStatus     CommercialSettlementStatus @default(NOT_APPLICABLE)
  paymentTerms         String?
  awardedAt            DateTime
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  job                  Job?                       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  guestAuction         GuestAuction?              @relation(fields: [guestAuctionId], references: [id], onDelete: Restrict)
  buyerCompany         Company?                   @relation("CommercialTransactionBuyerCompany", fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  buyerUser            User?                      @relation("CommercialTransactionBuyerUser", fields: [buyerUserId], references: [id], onDelete: Restrict)
  providerCompany      Company                    @relation("CommercialTransactionProviderCompany", fields: [providerCompanyId], references: [id], onDelete: Restrict)
  charges              PlatformCharge[]
  payments             PaymentRecord[]
  invoices             InvoiceRecord[]
  adjustments          RefundAdjustment[]

  @@index([buyerCompanyId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([providerCompanyId, createdAt])
  @@index([paymentStatus])
  @@index([settlementStatus])
}

model FeeRule {
  id               String      @id @default(cuid())
  name             String
  transactionScope String?
  feeKind          FeeKind
  percentageBps    Int?
  fixedAmountMinor BigInt?
  minimumAmountMinor BigInt?
  maximumAmountMinor BigInt?
  currency         String      @default("AUD")
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  charges          PlatformCharge[]

  @@index([active, effectiveFrom])
  @@index([transactionScope])
}

model PlatformCharge {
  id                    String               @id @default(cuid())
  commercialTransactionId String?
  feeRuleId             String?
  chargeType            PlatformChargeType
  status                PlatformChargeStatus @default(PENDING)
  amountMinor           BigInt
  taxAmountMinor        BigInt               @default(0)
  currency              String               @default("AUD")
  calculationSnapshot   Json?
  dueAt                 DateTime?
  paidAt                DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  commercialTransaction CommercialTransaction? @relation(fields: [commercialTransactionId], references: [id], onDelete: Restrict)
  feeRule               FeeRule?             @relation(fields: [feeRuleId], references: [id], onDelete: SetNull)

  @@index([commercialTransactionId, createdAt])
  @@index([status, dueAt])
  @@index([chargeType])
}

model PaymentRecord {
  id                    String                  @id @default(cuid())
  commercialTransactionId String
  provider              String?
  providerPaymentRef    String?
  paymentMethod         String?
  status                CommercialPaymentStatus @default(PENDING)
  amountMinor           BigInt
  currency              String                  @default("AUD")
  occurredAt            DateTime?
  metadata              Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  commercialTransaction CommercialTransaction   @relation(fields: [commercialTransactionId], references: [id], onDelete: Cascade)

  @@index([commercialTransactionId, createdAt])
  @@index([provider, providerPaymentRef])
  @@index([status])
}

model InvoiceRecord {
  id                    String                @id @default(cuid())
  commercialTransactionId String
  invoiceType           InvoiceType
  invoiceNumber         String?               @unique
  status                InvoiceStatus         @default(DRAFT)
  subtotalMinor         BigInt
  taxAmountMinor        BigInt                @default(0)
  totalMinor            BigInt
  currency              String                @default("AUD")
  issuedAt              DateTime?
  dueAt                 DateTime?
  paidAt                DateTime?
  externalReference     String?
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  commercialTransaction CommercialTransaction @relation(fields: [commercialTransactionId], references: [id], onDelete: Restrict)

  @@index([commercialTransactionId, createdAt])
  @@index([status, dueAt])
}

model RefundAdjustment {
  id                    String                   @id @default(cuid())
  commercialTransactionId String
  adjustmentType        AdjustmentType
  amountMinor           BigInt
  taxAmountMinor        BigInt                  @default(0)
  currency              String                  @default("AUD")
  reason                String?
  providerReference     String?
  occurredAt            DateTime                @default(now())
  createdAt             DateTime                @default(now())
  commercialTransaction CommercialTransaction   @relation(fields: [commercialTransactionId], references: [id], onDelete: Restrict)

  @@index([commercialTransactionId, occurredAt])
  @@index([adjustmentType])
}

model Promotion {
  id                 String          @id @default(cuid())
  listingId          String?
  tenderId           String?
  guestAuctionId     String?
  purchaserCompanyId String?
  purchaserUserId    String?
  promotionType      PromotionType
  status             PromotionStatus @default(PENDING)
  amountMinor        BigInt?
  taxAmountMinor     BigInt?         @default(0)
  currency           String          @default("AUD")
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  listing            Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tender             Tender?         @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  guestAuction       GuestAuction?   @relation(fields: [guestAuctionId], references: [id], onDelete: Cascade)
  purchaserCompany   Company?        @relation("PromotionPurchaserCompany", fields: [purchaserCompanyId], references: [id], onDelete: Restrict)
  purchaserUser      User?           @relation("PromotionPurchaserUser", fields: [purchaserUserId], references: [id], onDelete: Restrict)

  @@index([listingId, status])
  @@index([tenderId, status])
  @@index([guestAuctionId, status])
  @@index([status, startsAt, endsAt])
}

enum CompanyRole {
  OWNER
  ADMIN
  MANAGER
  DISPATCHER
  DRIVER
  WAREHOUSE
  STAFF
}

enum CommercialPaymentMode {
  UNSET
  PLATFORM
  COMMERCIAL_TERMS
  MANUAL
}

enum CommercialPaymentStatus {
  UNSET
  NOT_REQUIRED
  PENDING
  REQUIRES_ACTION
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  OVERDUE
  CANCELLED
}

enum CommercialSettlementStatus {
  NOT_APPLICABLE
  PENDING
  AVAILABLE
  PAID_OUT
  FAILED
  HELD
}

enum FeeKind {
  PERCENTAGE
  FIXED
  PERCENTAGE_WITH_LIMITS
}

enum PlatformChargeType {
  SUCCESS_FEE
  PROMOTION
  OTHER
}

enum PlatformChargeStatus {
  PENDING
  DUE
  PAID
  WAIVED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum InvoiceType {
  CUSTOMER_TRANSACTION
  FROTO_FEE
  PROMOTION
  CREDIT_NOTE
  RECEIPT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CREDITED
}

enum AdjustmentType {
  REFUND
  PARTIAL_REFUND
  CREDIT
  DEBIT
  CORRECTION
}

enum PromotionType {
  FEATURED
  PRIORITY
  URGENT
  FEATURED_WAREHOUSE
  HIGHLIGHTED_TENDER
}

enum PromotionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}
